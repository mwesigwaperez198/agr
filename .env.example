# Runtime
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
API_PORT=8787
PUBLIC_APP_NAME=HarvestLink
PUBLIC_TAGLINE=Connecting Farmers to Markets
PUBLIC_CURRENCY=UGX
PUBLIC_DEFAULT_LANGUAGE=en

# Persistence
DATABASE_URL=postgresql://user:password@localhost:5432/agri_connect
REDIS_URL=redis://localhost:6379
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Identity
SESSION_SECRET=replace-with-at-least-32-random-bytes
PASSWORD_PEPPER=
SMS_PROVIDER=
SMS_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=

# AI / language / voice
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=
SPEECH_PROVIDER=
SPEECH_API_KEY=

# Dynamic payment-method registry
# Required in production: base64-encoded 32-byte key (for example, generate with
# `openssl rand -base64 32`). Store it in managed secrets infrastructure, never Git.
PAYMENT_CONFIG_ENCRYPTION_KEY=
# Provider credentials are write-only through the protected administrator API.
# Licensed production webhook/adaptor activation remains a deployment release gate.

# Integrations
WEATHER_PROVIDER=
WEATHER_API_KEY=
MAP_PROVIDER=
MAP_API_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
LOG_LEVEL=info

# Development-only bootstrap (never set a production password in source control)
DEV_ADMIN_PHONE=+256700000001
DEV_ADMIN_PASSWORD=
DEV_FARMER_PASSWORD=
DEV_BUYER_PASSWORD=
# Development-only authenticator code used by the role demo. A production build
# integrates a real TOTP/WebAuthn verifier and never stores a static OTP.
DEMO_TOTP_CODE=
